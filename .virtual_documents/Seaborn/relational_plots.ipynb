


import seaborn as sns
import matplotlib.pyplot as plt


tips = sns.load_dataset("tips")


tips


sns.relplot(
    data=tips,
    x="total_bill",
    y="tip",
    hue="smoker",# color
    style="smoker",# scatter shape
    size="size", #scatter size
)


sns.scatterplot(
    data=tips,
    x="total_bill", y="tip",
    hue="time",
)


sns.lineplot(
    data=tips,
    x="total_bill", y="tip", style="smoker",
)


sns.relplot(
    data=tips,
    x="total_bill", y="tip", col="sex",
    hue="smoker", style="smoker", size="size",
)


dots = sns.load_dataset("dots")
print(dots.head())
sns.relplot(
    data=dots, kind="line",
    x="time", y="firing_rate", col="align",
    hue="choice", size="coherence", style="choice",
    facet_kws=dict(sharex=False),
)



